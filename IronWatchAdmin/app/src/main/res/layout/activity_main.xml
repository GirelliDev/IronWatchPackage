<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgg"
    android:gravity="top|center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:fontFamily="@font/roboto_mono_bold"
        android:gravity="center"
        android:text="IronWatch Admin"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textAcessoRestrito"
        android:layout_width="367dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:fontFamily="@font/roboto_mono_bold"
        android:gravity="center"
        android:text="ACESSO RESTRITO"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textDescricao"
        android:layout_width="367dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto_mono_bold"
        android:gravity="center"
        android:text="Insira o código rotativo fornecido pelo servidor"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/loginbox"
        android:layout_width="354dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_loginbox"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/edtToken"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edittext"
            android:hint="Código"
            android:fontFamily="@font/roboto_mono_bold"
            android:inputType="text"
            android:padding="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />
            <EditText
            android:id="@+id/edtLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:fontFamily="@font/roboto_mono_bold"
            android:hint="Login"
            android:inputType="text"
            android:padding="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />

        <!-- Senha -->

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edittext"
            android:fontFamily="@font/roboto_mono_bold"
            android:hint="Senha"
            android:inputType="textPassword"
            android:padding="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />


        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:fontFamily="@font/roboto_mono_bold"
            android:text="Entrar"
            android:textAllCaps="true"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>